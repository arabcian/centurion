<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>centurion</vendor>
  <!-- Eleven Rust root helpers, each pinned by exec.path; installed root:root 0755
       (nvcurve-root-helper 0700) under /usr/libexec/centurion.
       The password-less grant (wheel, local active session) comes only from
       /etc/polkit-1/rules.d/49-centurion.rules; the defaults below
       are the safe fallback when that file is absent.
       com.centurion.firmware.write is never granted silently: it
       covers changes that persist in firmware (BIOS memory timings, BIOS CPU OC,
       GPU MUX mode) and asks for the administrator password every time. -->
  <action id="com.centurion.fwattr.write">
    <description>Write a firmware_attributes sysfs value</description>
    <description xml:lang="tr">Bir firmware_attributes sysfs değerini yaz</description>
    <message>Authentication is required to write a firmware attribute value</message>
    <message xml:lang="tr">Bir firmware özniteliği değerini yazmak için kimlik doğrulama gerekiyor</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/fwattr-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.centurion.nvcurve.set-params">
    <description>Apply NVIDIA GPU V/F curve settings via Centurion</description>
    <description xml:lang="tr">Centurion üzerinden NVIDIA GPU V/F eğrisi ayarlarını uygula</description>
    <message>Administrator authentication required (NVIDIA curve optimizer)</message>
    <message xml:lang="tr">Yönetici kimlik doğrulaması gerekiyor (NVIDIA eğri optimizasyonu)</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/nvcurve-root-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.centurion.nvcurve.sensors">
    <description>Read NVIDIA GPU hotspot and memory temperatures (read-only)</description>
    <description xml:lang="tr">NVIDIA GPU hotspot ve bellek sıcaklıklarını oku (salt okunur)</description>
    <message>Authentication is required to read NVIDIA GPU sensors</message>
    <message xml:lang="tr">NVIDIA GPU sensörlerini okumak için kimlik doğrulama gerekiyor</message>
    <!-- Read-only, fixed register offsets, no input: the active local session gets it without a prompt. -->
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>yes</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/nvcurve-sensors</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.centurion.ec.sensors">
    <description>Read the GPU temperature from the embedded controller (read-only)</description>
    <description xml:lang="tr">GPU sıcaklığını gömülü denetleyiciden (EC) oku (salt okunur)</description>
    <message>Authentication is required to read EC sensors</message>
    <message xml:lang="tr">EC sensörlerini okumak için kimlik doğrulama gerekiyor</message>
    <!-- Read-only, one fixed WMI feature id, no input: the active local session gets it without a prompt. -->
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>yes</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/legion-ec-sensors</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.centurion.health.read">
    <description>Read hardware error events from the kernel log (read-only)</description>
    <description xml:lang="tr">Çekirdek günlüğünden donanım hata olaylarını oku (salt okunur)</description>
    <message>Authentication is required to read hardware error events</message>
    <message xml:lang="tr">Donanım hata olaylarını okumak için kimlik doğrulama gerekiyor</message>
    <!-- Read-only, classified events only (no raw log lines): the active local session gets it without a prompt. -->
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>yes</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/health-reader</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.centurion.amdgpu.tune">
    <description>Change AMD GPU clocks, voltage, power limit and fan settings via Centurion</description>
    <description xml:lang="tr">Centurion üzerinden AMD GPU saat, voltaj, güç limiti ve fan ayarlarını değiştir</description>
    <message>Authentication is required to overclock or undervolt the AMD GPU</message>
    <message xml:lang="tr">AMD GPU'ya overclock veya undervolt uygulamak için kimlik doğrulama gerekiyor</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/amdgpu-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.centurion.ryzen.set-curve">
    <description>Apply RyzenAdj Curve Optimizer values via Centurion</description>
    <description xml:lang="tr">Centurion üzerinden RyzenAdj Curve Optimizer değerlerini uygula</description>
    <message>Authentication is required to change the CPU Curve Optimizer voltage offsets</message>
    <message xml:lang="tr">CPU Curve Optimizer voltaj offsetlerini değiştirmek için kimlik doğrulama gerekiyor</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/ryzen-co-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.centurion.intel.undervolt">
    <description>Apply Intel CPU voltage offsets and power limits via Centurion</description>
    <description xml:lang="tr">Centurion üzerinden Intel CPU voltaj offsetlerini ve güç limitlerini uygula</description>
    <message>Authentication is required to change the CPU voltage offsets (MSR access)</message>
    <message xml:lang="tr">CPU voltaj offsetlerini değiştirmek için kimlik doğrulama gerekiyor (MSR erişimi)</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/intel-uv-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.centurion.gpu.power">
    <description>Set experimental GPU power limits via Centurion</description>
    <description xml:lang="tr">Centurion ile deneysel GPU güç limitlerini ayarla</description>
    <message>Authentication is required to change the GPU power ceiling (EC table)</message>
    <message xml:lang="tr">GPU güç tavanını değiştirmek için kimlik doğrulama gerekiyor (EC tablosu)</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/legion-gpu-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.centurion.profile.set">
    <description>Change the ACPI platform power profile</description>
    <description xml:lang="tr">ACPI platform güç profilini değiştir</description>
    <message>Authentication is required to change the laptop power profile</message>
    <message xml:lang="tr">Dizüstü bilgisayarın güç profilini değiştirmek için kimlik doğrulama gerekiyor</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/legion-profile-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.centurion.tune.apply">
    <description>Apply or restore system tuning values via Centurion</description>
    <description xml:lang="tr">Centurion üzerinden sistem optimizasyon değerlerini uygula veya geri yükle</description>
    <message>Authentication is required to change kernel tuning settings</message>
    <message xml:lang="tr">Çekirdek optimizasyon ayarlarını değiştirmek için kimlik doğrulama gerekiyor</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/tune-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.centurion.tune.profile">
    <description>Apply an approved optimization preset via Centurion</description>
    <description xml:lang="tr">Centurion üzerinden onaylı bir optimizasyon ön ayarını uygula</description>
    <message>Authentication is required to apply an optimization preset</message>
    <message xml:lang="tr">Bir optimizasyon ön ayarını uygulamak için kimlik doğrulama gerekiyor</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/tune-profile-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.centurion.firmware.write">
    <description>Change firmware settings that persist across reboots (memory timings, CPU overclocking, GPU mode)</description>
    <description xml:lang="tr">Yeniden başlatmadan sonra da kalan firmware ayarlarını değiştir (bellek zamanlamaları, CPU hız aşırtma, GPU modu)</description>
    <message>Authentication is required to change firmware settings that take effect at the next boot. Wrong values can keep the laptop from starting.</message>
    <message xml:lang="tr">Bir sonraki açılışta etkin olacak firmware ayarlarını değiştirmek için kimlik doğrulama gerekiyor. Hatalı değerler bilgisayarın açılmasını engelleyebilir.</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/legion-firmware-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.centurion.lighting.write">
    <description>Change the keyboard lighting via Centurion</description>
    <description xml:lang="tr">Centurion ile klavye aydınlatmasını değiştir</description>
    <message>Authentication is required to change the keyboard lighting (only needed while the udev rule is not applied)</message>
    <message xml:lang="tr">Klavye aydınlatmasını değiştirmek için kimlik doğrulama gerekiyor (yalnızca udev kuralı henüz uygulanmamışken)</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/lighting-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.centurion.netguard">
    <description>Change the network guard rules (IP blacklist, program whitelist) or abort a connection</description>
    <description xml:lang="tr">Ağ koruması kurallarını (IP kara listesi, program beyaz listesi) değiştir veya bir bağlantıyı kes</description>
    <message>Authentication is required to change the network guard rules</message>
    <message xml:lang="tr">Ağ koruması kurallarını değiştirmek için kimlik doğrulama gerekiyor</message>
    <!-- Never silent (see the rules file): a guarded program runs as the user and must not be able to whitelist itself. -->
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/netguard-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.centurion.backup">
    <description>Create, verify or restore a system backup, or restore saved Centurion system settings</description>
    <description xml:lang="tr">Sistem yedeği oluştur, doğrula veya geri yükle ya da kayıtlı Centurion sistem ayarlarını geri yükle</description>
    <message>Authentication is required to back up or restore the system</message>
    <message xml:lang="tr">Sistemi yedeklemek veya geri yüklemek için kimlik doğrulama gerekiyor</message>
    <!-- Never silent, never cached (see the rules file): the image holds /etc/shadow and a restore replaces any file. -->
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/backup-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
