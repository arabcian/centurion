# Centurion — calibration at boot (systemd). Counterpart of packaging/openrc/centurion-calibrate-boot.
# Does nothing unless a calibration was scheduled (Optimizations → Autotune → "Calibrate at next boot",
# or `sudo centurion-calibrate --schedule-boot`); see the OpenRC script for what it does then.
# One-shot: scheduling enables it, and it disables itself once it has taken the schedule.

[Unit]
Description=Centurion scheduled calibration at boot
Documentation=file:///usr/share/doc/centurion/README.md
ConditionPathExists=/var/lib/centurion/calibrate-on-boot.json
Wants=centurion-boot-guard.service
After=local-fs.target systemd-modules-load.service systemd-sysctl.service centurion-boot-guard.service centurion-tune.service
Before=display-manager.service

[Service]
Type=simple
ExecStart=@BINDIR@/centurion-calibrate --boot-run
# SIGINT: every session restores what it changed and keeps what it measured.
KillSignal=SIGINT
TimeoutStopSec=150
# Writes /sys and /proc/sys (the knobs under test), /etc/centurion and /var; reads /dev/input
# (activity only). A scheduled scene's power context is stored in the root-owned flag when it is
# scheduled, so no home directory is read.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=yes
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictSUIDSGID=yes
RestrictNamespaces=yes

[Install]
WantedBy=multi-user.target
