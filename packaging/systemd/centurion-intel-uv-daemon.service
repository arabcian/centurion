# Centurion — Intel undervolt daemon (optional, instead of
# centurion-intel-uv.service). Counterpart of packaging/openrc/centurion-intel-uv-daemon.
#
#   systemctl enable --now centurion-intel-uv-daemon.service

[Unit]
Wants=centurion-boot-guard.service
Description=Centurion Intel undervolt daemon
Conflicts=centurion-intel-uv.service
After=systemd-modules-load.service centurion-boot-guard.service

[Service]
# Skipped (not failed) while centurion-boot-guard has the boot presets paused.
ExecCondition=@LIBEXEC@/centurion-boot-guard check
Type=simple
ExecStart=@BINDIR@/centurion-intel-uv daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectHome=yes
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
