# Centurion boot guard (systemd). Pulled in by the preset units.
# Arms at boot, disarms after 3 minutes of stable uptime or on a clean
# shutdown; a boot that dies armed pauses the preset units (ExecCondition)
# until they are resumed in the app (Home) or with `centurion-boot-guard reset`.

[Unit]
Description=Centurion boot guard
Documentation=file:///usr/share/doc/centurion/README.md
After=local-fs.target systemd-sysctl.service systemd-tmpfiles-setup.service
Before=tlp.service centurion-tune.service nvcurve-autoload.service centurion-intel-uv.service centurion-intel-uv-daemon.service

[Service]
Type=simple
ExecStartPre=@LIBEXEC@/centurion-boot-guard arm
ExecStart=@LIBEXEC@/centurion-boot-guard watch
TimeoutStopSec=10
NoNewPrivileges=yes
PrivateTmp=yes
# No PrivateNetwork: `arm` records the boot defaults, and the net.* values must
# be the host's, not those of a fresh empty network namespace.
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/centurion
StateDirectory=centurion

[Install]
WantedBy=multi-user.target
