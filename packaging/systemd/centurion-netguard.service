# Centurion — network guard daemon (Health → Network).
# Counterpart of packaging/openrc/centurion-netguard.
#
#   systemctl enable --now centurion-netguard.service

[Unit]
Description=Centurion network guard (IP blacklist, Wine/.exe guard)
After=systemd-modules-load.service nftables.service network-pre.target

[Service]
Type=simple
ExecStart=@BINDIR@/centurion-netguard daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
# nft + nfqueue + SOCK_DESTROY (NET_ADMIN), /proc/<pid>/{exe,fd,maps} of every user (SYS_PTRACE,
# DAC_*), the root:wheel log files (CHOWN/FOWNER), SIGHUP to itself (KILL).
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_KILL
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
RestrictAddressFamilies=AF_NETLINK AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
