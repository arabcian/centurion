# Centurion — boot-time system tuning preset (systemd).
# Counterpart of packaging/openrc/centurion-tune.
#
# Applies /etc/centurion/tune-boot.json (Optimizations tab →
# "⏻ Apply at boot"). Every changed value is recorded under
# /run/centurion/tune; `systemctl stop centurion-tune` (or "Restore
# originals" in the GUI) writes the originals back.
#
#   systemctl enable --now centurion-tune.service

[Unit]
Wants=centurion-boot-guard.service
Description=Centurion boot tuning preset
Documentation=file:///usr/share/doc/centurion/README.md
ConditionPathExists=/etc/centurion/tune-boot.json
# After sysctl so our values win over /etc/sysctl.d; after module loading so
# module parameters (snd_hda_intel, usbcore, amd_pstate) exist.
After=local-fs.target systemd-modules-load.service systemd-sysctl.service systemd-udev-trigger.service centurion-boot-guard.service
Before=display-manager.service

[Service]
# Skipped (not failed) while centurion-boot-guard has the boot presets paused.
ExecCondition=@LIBEXEC@/centurion-boot-guard check
Type=oneshot
RemainAfterExit=yes
# The helper takes one JSON request on stdin (StandardInputText would feed the
# same text to ExecStop too, hence the pipes). Its JSON reply goes to the
# journal: journalctl -u centurion-tune
ExecStart=/bin/sh -c "echo '{\"op\":\"boot\"}' | @LIBEXEC@/tune-helper"
ExecStop=/bin/sh -c "echo '{\"op\":\"restore\"}' | @LIBEXEC@/tune-helper"
# Writes /sys, /proc/sys, /proc/irq and PCI config space and may mount
# debugfs, so kernel-tunable protections cannot be used; the rest is closed.
NoNewPrivileges=yes
PrivateTmp=yes
# No PrivateNetwork: the preset's net.* sysctls, Wi-Fi power save (iw) and
# Ethernet EEE / Wake-on-LAN (ethtool) must reach the real network namespace;
# in a private one they were written to an empty namespace and lost.
ProtectHome=yes
ProtectSystem=full
ProtectClock=yes
ProtectHostname=yes
# iw talks nl80211 (netlink), ethtool uses netlink or an AF_INET ioctl socket.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
