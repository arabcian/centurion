#!/sbin/openrc-run
# Centurion boot guard. Pulled in by the preset services (need).
# Arms at boot, disarms after 3 minutes of stable uptime or on a clean
# shutdown (stop); a boot that dies armed pauses the preset services until
# they are resumed in the app (Home) or with `centurion-boot-guard reset`.

description="Pause Centurion boot presets after a crashed boot"
GUARD="@LIBEXEC@/centurion-boot-guard"
pidfile="/run/${RC_SVCNAME}.pid"

depend() {
	need localmount
	# The boot-default snapshot must see the user's sysctl.conf but not TLP.
	after sysctl
	before tlp centurion-tune nvcurve-autoload centurion-intel-uv centurion-intel-uv-daemon
}

start() {
	ebegin "Arming Centurion boot guard"
	"${GUARD}" arm
	eend $?
	# Stays up: disarms once the boot has been stable for the window (180 s)
	# and runs the flight recorder (one sensor sample every 5 s).
	start-stop-daemon --start --background --make-pidfile --pidfile "${pidfile}" \
		--exec "${GUARD}" -- watch
}

stop() {
	# Clean shutdown / reboot: this boot did not crash (also recorded for the
	# GUI's login guard, so a quick reboot after login is not taken for a crash).
	# watch records it on SIGTERM; if it is not running, record it here.
	start-stop-daemon --stop --quiet --pidfile "${pidfile}" --retry TERM/10 >/dev/null 2>&1 \
		|| "${GUARD}" shutdown >/dev/null 2>&1
	return 0
}
