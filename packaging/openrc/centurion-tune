#!/sbin/openrc-run
# Centurion — boot-time system tuning preset.
#
# Applies /etc/centurion/tune-boot.json (written by the
# Optimizations tab → "Apply at boot"). Every changed value is recorded under
# /run/centurion/tune, so `rc-service centurion-tune stop` (or
# "Restore originals" in the GUI) puts the kernel defaults back.
#
#   rc-update add centurion-tune boot

description="Apply the Centurion boot tuning preset"
HELPER="@LIBEXEC@/tune-helper"

depend() {
	need localmount centurion-boot-guard
	after modules sysctl
	before xdm display-manager
}

start() {
	if ! "@LIBEXEC@/centurion-boot-guard" check 2>/dev/null; then
		ewarn "Centurion boot presets are paused after a crashed boot — resume them in the app (Home)"
		return 0
	fi
	[ -f /etc/centurion/tune-boot.json ] || { einfo "No boot preset set"; return 0; }
	ebegin "Applying Centurion boot tuning"
	printf '%s' '{"op":"boot"}' | "${HELPER}" >/dev/null
	eend $? "Some settings could not be applied (see: centurion-gamemode STATUS)"
}

stop() {
	ebegin "Restoring original tuning values"
	printf '%s' '{"op":"restore"}' | "${HELPER}" >/dev/null
	eend $?
}
