#!/sbin/openrc-run
# Centurion — Intel undervolt boot profile.
#
# Applies /etc/centurion/intel-uv-boot.json (Intel Undervolt tab →
# "Apply at boot & resume"). Re-applying after resume is done by the elogind
# sleep hook (voltage offsets are lost on S3). `stop` resets the voltage
# planes to 0 mV.
#
#   rc-update add centurion-intel-uv boot

description="Apply the Centurion Intel undervolt profile"
HELPER="@LIBEXEC@/intel-uv-helper"

depend() {
	need localmount centurion-boot-guard
	after modules
}

start() {
	if ! "@LIBEXEC@/centurion-boot-guard" check 2>/dev/null; then
		ewarn "Centurion boot presets are paused after a crashed boot — resume them in the app (Home)"
		return 0
	fi
	[ -f /etc/centurion/intel-uv-boot.json ] || { einfo "No Intel undervolt boot profile set"; return 0; }
	ebegin "Applying Intel undervolt profile"
	printf '%s' '{"op":"boot"}' | "${HELPER}" >/dev/null
	eend $? "Some values were rejected (run: centurion-intel-uv boot)"
}

stop() {
	ebegin "Resetting Intel voltage offsets to 0 mV"
	printf '%s' '{"op":"reset"}' | "${HELPER}" >/dev/null
	eend $?
}
