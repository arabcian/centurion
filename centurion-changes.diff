+void SleepPage::checkHibernate() {
+    hib_->setEnabled(false);
+    userhelper::run(QJsonObject{{QStringLiteral("op"), QStringLiteral("hibernate_check")}}, this, [this](const QJsonObject &r) {
+        hib_->setEnabled(true);
+        hibOut_->setVisible(true);
