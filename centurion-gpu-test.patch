@@ -0,0 +1,25 @@
+[package]
+name = "centurion-gpustress"
+version = "0.1.0"
+edition = "2021"
+rust-version = "1.75"
+description = "Centurion GPU stability test: Vulkan compute work with a known result, every wrong bit counted"
+license = "GPL-3.0-or-later"
+
+[[bin]]
+name = "centurion-gpustress"
+path = "src/main.rs"
+
+[dependencies]
+# Vulkan is loaded at run time (Entry::load), so no SDK and no link-time libvulkan.
+ash = { version = "0.38", default-features = false, features = ["loaded", "std"] }
+serde_json = "1"
+libc = "0.2"
+
+[build-dependencies]
+# WGSL -> SPIR-V at build time, so no external shader compiler is needed.
+naga = { version = "22", features = ["wgsl-in", "spv-out"] }
+
+[features]
+# Test-only: flips one word after the write dispatch of pass 3 (VRAM) / perturbs one invocation (core).
+fault-inject = []
diff --git a/crates/centurion-gpustress/build.rs b/crates/centurion-gpustress/build.rs
new file mode 100644
index 0000000..b81596a
--- /dev/null
+++ b/crates/centurion-gpustress/build.rs
@@ -0,0 +1,19 @@
+// Compiles shaders/*.wgsl to SPIR-V into OUT_DIR (embedded with include_bytes!), so building needs no
+// external shader compiler and the WGSL source is what ships.
+use std::{env, fs, path::Path};
+
+fn main() {
+    let out = env::var("OUT_DIR").unwrap();
+    println!("cargo:rerun-if-changed=shaders");
+    for e in fs::read_dir("shaders").unwrap().flatten() {
+        let path = e.path();
+        if path.extension().map_or(true, |x| x != "wgsl") { continue; }
+        let src = fs::read_to_string(&path).unwrap();
+        let module = naga::front::wgsl::parse_str(&src).unwrap_or_else(|err| panic!("{}: {}", path.display(), err.emit_to_string(&src)));
+        let info = naga::valid::Validator::new(naga::valid::ValidationFlags::all(), naga::valid::Capabilities::empty())
+            .validate(&module).unwrap_or_else(|err| panic!("{}: {err:?}", path.display()));
+        let words = naga::back::spv::write_vec(&module, &info, &naga::back::spv::Options::default(), None).unwrap();
+        let bytes: Vec<u8> = words.iter().flat_map(|w| w.to_le_bytes()).collect();
+        fs::write(Path::new(&out).join(path.file_stem().unwrap()).with_extension("spv"), bytes).unwrap();
+    }
+}
diff --git a/crates/centurion-gpustress/shaders/core.wgsl b/crates/centurion-gpustress/shaders/core.wgsl
new file mode 100644
index 0000000..0d47451
--- /dev/null
+++ b/crates/centurion-gpustress/shaders/core.wgsl
@@ -0,0 +1,75 @@
+// Core test (docs/GPUSTRESS.md §5): long dependent f32 + integer arithmetic that keeps the shader cores
+// at full clock. The result is not known in advance: a correct GPU gives the same bits every time for the
+// same pipeline and inputs, so cores.rs compares each run with a reference run of the same work.
+
+struct Params {
+    n: u32,        // loop iterations (calibrated to ~100 ms a dispatch)
+    seed: u32,     // changes every 60 s: a different data set, a new reference
+    perturb: u32,  // invocation whose input is disturbed; 0xffffffff = none (only the fault-inject build sets it)
+    pad: u32,
+}
+// count of all mismatches, then the first 16 as (word index, expected, actual): same layout as vram.wgsl
+struct Found { count: atomic<u32>, first: array<u32, 48> }
+
+@group(0) @binding(0) var<storage, read_write> out: array<u32>;
+@group(0) @binding(1) var<uniform> p: Params;
+@group(0) @binding(2) var<storage, read_write> reference: array<u32>;
+@group(0) @binding(3) var<storage, read_write> found: Found;
+
+const S8 = vec4<u32>(8u);
+const S15 = vec4<u32>(15u);
+const S24 = vec4<u32>(24u);
+
+// murmur3-style 32-bit finaliser, on four lanes
+fn hash4(x: vec4<u32>) -> vec4<u32> {
+    var h = x;
+    h ^= h >> vec4<u32>(16u);
+    h *= vec4<u32>(0x85ebca6bu);
+    h ^= h >> vec4<u32>(13u);
+    h *= vec4<u32>(0xc2b2ae35u);
+    h ^= h >> vec4<u32>(16u);
+    return h;
+}
+
+// Four independent accumulators per invocation (instruction-level parallelism). Per iteration and lane:
+//   f = fma(f, a, b + small term from u)   a in [0.90, 0.999), b in [0.001, 0.002): f stays in [0.001, ~2.3],
+//                                          so never inf / NaN / denormal
+//   u = (u * 0x9E3779B1) ^ (u >> 15) ^ bits(f)
+// Every step depends on the previous one and both the f32 and the integer units are busy. Feeding u back
+// into the addend keeps f's operands changing: a settled f would stop toggling the multiplier.
+@compute @workgroup_size(256)
+fn burn(@builtin(global_invocation_id) gid: vec3<u32>) {
+    let id = gid.x;
+    let lane = vec4<u32>(0u, 1u, 2u, 3u) + vec4<u32>(id * 4u);
+    let s = vec4<u32>(hash4(vec4<u32>(p.seed, 0u, 0u, 0u)).x);
+    var u = hash4(lane ^ s);
+    let a = vec4<f32>(0.9) + vec4<f32>(hash4(u ^ vec4<u32>(0x68e31da4u)) >> S8) * (0.099 / 16777216.0);
+    let b = vec4<f32>(0.001) + vec4<f32>(hash4(u ^ vec4<u32>(0xb5297a4du)) >> S8) * (0.001 / 16777216.0);
+    var f = vec4<f32>(1.0) + vec4<f32>(hash4(u ^ vec4<u32>(0x1b873593u)) >> S8) * (1.0 / 16777216.0);
+    if id == p.perturb { u.x ^= 1u; }
+    for (var i = 0u; i < p.n; i++) {
+        f = fma(f, a, b + vec4<f32>(u >> S24) * 1.0e-6);
+        u = (u * vec4<u32>(0x9E3779B1u)) ^ (u >> S15) ^ bitcast<vec4<u32>>(f);
+    }
+    out[id * 4u] = u.x;
+    out[id * 4u + 1u] = u.y;
+    out[id * 4u + 2u] = u.z;
+    out[id * 4u + 3u] = u.w;
+}
+
+@compute @workgroup_size(256)
+fn compare(@builtin(global_invocation_id) gid: vec3<u32>) {
+    for (var j = 0u; j < 4u; j++) {
+        let i = gid.x * 4u + j;
+        let want = reference[i];
+        let got = out[i];
+        if got != want {
+            let slot = atomicAdd(&found.count, 1u);
+            if slot < 16u {
+                found.first[slot * 3u] = i;
+                found.first[slot * 3u + 1u] = want;
+                found.first[slot * 3u + 2u] = got;
+            }
+        }
+    }
+}
diff --git a/crates/centurion-gpustress/shaders/vram.wgsl b/crates/centurion-gpustress/shaders/vram.wgsl
new file mode 100644
index 0000000..4453436
--- /dev/null
+++ b/crates/centurion-gpustress/shaders/vram.wgsl
@@ -0,0 +1,74 @@
+// VRAM test patterns (docs/GPUSTRESS.md §4). The expected value of a word depends only on
+// (pattern, global word index, seed, phase), so `verify` needs no copy of the data.
+// vram.rs holds the same functions in Rust; its unit test compares the two by running this shader.
+
+struct Params {
+    pattern: u32,  // 0 addr, 1 walk1, 2 walk0, 3 solid, 4 random
+    seed: u32,     // the pass number
+    base: u32,     // global index of this chunk's first word (chunk index x words per chunk)
+    words: u32,    // words in this chunk
+    phase: u32,    // solid only: 0 = the pass's value, 1 = its inverse
+    pad0: u32,
+    pad1: u32,
+    pad2: u32,
+}
+// count of all mismatches, then the first 16 as (global word index, expected, actual)
+struct Found { count: atomic<u32>, first: array<u32, 48> }
+
+@group(0) @binding(0) var<storage, read_write> data: array<u32>;
+@group(0) @binding(1) var<uniform> p: Params;
+@group(0) @binding(2) var<storage, read_write> found: Found;
+
+// murmur3-style 32-bit finaliser
+fn hash(x: u32) -> u32 {
+    var h = x;
+    h ^= h >> 16u;
+    h *= 0x85ebca6bu;
+    h ^= h >> 13u;
+    h *= 0xc2b2ae35u;
+    h ^= h >> 16u;
+    return h;
+}
+
+fn value(index: u32) -> u32 {
+    switch p.pattern {
+        case 0u: { return index ^ hash(p.seed); }
+        case 1u: { return 1u << ((index + p.seed) % 32u); }
+        case 2u: { return ~(1u << ((index + p.seed) % 32u)); }
+        case 3u: { return select(0u, 0xffffffffu, ((p.seed + p.phase) & 1u) == 1u); }
+        default: { return hash(index ^ hash(p.seed + 0x9e3779b9u)); }
+    }
+}
+
+// 256 invocations x 4 consecutive words; the dispatch is 2D because a 256 MiB chunk needs 65536
+// workgroups, more than the guaranteed maxComputeWorkGroupCount of 65535.
+fn first_word(wg: vec3<u32>, nwg: vec3<u32>, li: u32) -> u32 {
+    return ((wg.y * nwg.x + wg.x) * 256u + li) * 4u;
+}
+
+@compute @workgroup_size(256)
+fn fill(@builtin(workgroup_id) wg: vec3<u32>, @builtin(num_workgroups) nwg: vec3<u32>, @builtin(local_invocation_index) li: u32) {
+    let first = first_word(wg, nwg, li);
+    if first >= p.words { return; }  // words is a multiple of 4
+    for (var j = 0u; j < 4u; j++) {
+        data[first + j] = value(p.base + first + j);
+    }
+}
+
+@compute @workgroup_size(256)
+fn verify(@builtin(workgroup_id) wg: vec3<u32>, @builtin(num_workgroups) nwg: vec3<u32>, @builtin(local_invocation_index) li: u32) {
+    let first = first_word(wg, nwg, li);
+    if first >= p.words { return; }
+    for (var j = 0u; j < 4u; j++) {
+        let want = value(p.base + first + j);
+        let got = data[first + j];
+        if got != want {
+            let slot = atomicAdd(&found.count, 1u);
+            if slot < 16u {
+                found.first[slot * 3u] = p.base + first + j;
+                found.first[slot * 3u + 1u] = want;
+                found.first[slot * 3u + 2u] = got;
+            }
+        }
+    }
+}
diff --git a/crates/centurion-gpustress/src/cores.rs b/crates/centurion-gpustress/src/cores.rs
new file mode 100644
index 0000000..3f451a7
--- /dev/null
+++ b/crates/centurion-gpustress/src/cores.rs
@@ -0,0 +1,164 @@
+//! Core mode (docs/GPUSTRESS.md §5): runs the dependent arithmetic of core.wgsl and compares each run,
+//! word by word on the GPU, with a reference run of the same work. A correct GPU gives the same bits
+//! every time, so any difference is a fault; no result needs to be known in advance.
+use crate::ctx::{Buf, Ctx, Mem};
+use crate::device;
+use crate::{emit, end, init_failed, vk_end, State, STOP};
+use ash::vk;
+use serde_json::json;
+use std::time::{Duration, Instant};
+
+const INVOCATIONS: u32 = 1 << 20;  // fills any current GPU
+const GROUP: u32 = 256;
+const BYTES: u64 = INVOCATIONS as u64 * 4 * 4;
+const ROTATE: Duration = Duration::from_secs(60);  // the seed (and with it the reference) changes this often
+const NO_PERTURB: u32 = u32::MAX;
+const SPV: &[u8] = include_bytes!(concat!(env!("OUT_DIR"), "/core.spv"));
+
+struct Rig {
+    ctx: Ctx,
+    sets: [vk::DescriptorSet; 2],  // [0] burns into `cur`, [1] burns into `reference`; compare reads [0]
+    layout: vk::PipelineLayout,
+    burn: vk::Pipeline,
+    compare: vk::Pipeline,
+    params: Buf,
+    found: Buf,
+}
+
+impl Rig {
+    fn new(ctx: Ctx, cur: &Buf, reference: &Buf) -> Result<Rig, vk::Result> {
+        let l = &ctx.limits;
+        if l.max_compute_work_group_size[0] < GROUP || l.max_compute_work_group_invocations < GROUP || l.max_compute_work_group_count[0] < INVOCATIONS / GROUP {
+            return Err(vk::Result::ERROR_FEATURE_NOT_PRESENT);
+        }
+        let (st, un) = (vk::DescriptorType::STORAGE_BUFFER, vk::DescriptorType::UNIFORM_BUFFER);
+        let kinds = [st, un, st, st];
+        let (dsl, layout) = ctx.layout(&kinds)?;
+        let params = ctx.buffer(16, vk::BufferUsageFlags::UNIFORM_BUFFER, Mem::Host)?;
+        let found = ctx.buffer(4 * 49, vk::BufferUsageFlags::STORAGE_BUFFER, Mem::Host)?;
+        let sets = ctx.sets(dsl, &kinds, 2)?;
+        ctx.bind(sets[0], &[(st, cur), (un, &params), (st, reference), (st, &found)]);
+        ctx.bind(sets[1], &[(st, reference), (un, &params), (st, cur), (st, &found)]);
+        let module = ctx.module(SPV)?;
+        let burn = ctx.pipeline(layout, module, c"burn")?;
+        let compare = ctx.pipeline(layout, module, c"compare")?;
+        Ok(Rig { ctx, sets: [sets[0], sets[1]], layout, burn, compare, params, found })
+    }
+
+    fn dispatch(&self, pipeline: vk::Pipeline, set: vk::DescriptorSet) -> Result<f64, vk::Result> {
+        let t = Instant::now();
+        // SAFETY: recording into the command buffer `submit` has begun, with handles made by `new`.
+        self.ctx.submit(|d, cmd| unsafe {
+            d.cmd_bind_pipeline(cmd, vk::PipelineBindPoint::COMPUTE, pipeline);
+            d.cmd_bind_descriptor_sets(cmd, vk::PipelineBindPoint::COMPUTE, self.layout, 0, &[set], &[]);
+            d.cmd_dispatch(cmd, INVOCATIONS / GROUP, 1, 1);
+        })?;
+        Ok(t.elapsed().as_secs_f64())
+    }
+
+    /// One run of the arithmetic, into the reference buffer or the current one. Returns how long it took.
+    fn burn(&self, into_reference: bool, n: u32, seed: u32, perturb: u32) -> Result<f64, vk::Result> {
+        for (k, v) in [n, seed, perturb, 0].iter().enumerate() { self.params.set(k, *v); }
+        self.dispatch(self.burn, self.sets[into_reference as usize])
+    }
+
+    /// The current run against the reference: how many words differ and the first few.
+    fn compare(&self) -> Result<(u32, Vec<[u32; 3]>), vk::Result> {
+        self.found.set(0, 0);
+        self.dispatch(self.compare, self.sets[0])?;
+        Ok(self.found.mismatches())
+    }
+
+    /// Scales `n` so one dispatch takes about 100 ms, and never more than 500 ms: any timing between 50 ms
+    /// and 500 ms is accepted, and the n returned is one that was timed. A timing at a small n is mostly
+    /// launch overhead, so n grows at most 64x a round; it is capped so a bad timing cannot start a dispatch
+    /// long enough to trip a driver watchdog.
+    fn calibrate(&self, mut n: u32, seed: u32) -> Result<u32, vk::Result> {
+        for _ in 0..6 {
+            let t = self.burn(true, n, seed, NO_PERTURB)?;
+            if (0.05..=0.5).contains(&t) { break; }
+            n = (n as f64 * 0.1 / t.max(1e-6)).clamp(1.0, n as f64 * 64.0).min((1 << 20) as f64) as u32;
+        }
+        Ok(n)
+    }
+}
+
+enum Halt { Deadline, Stopped, Unstable }
+
+fn halt(deadline: Option<Instant>) -> Option<Halt> {
+    if STOP.load(std::sync::atomic::Ordering::SeqCst) { Some(Halt::Stopped) }
+    else if deadline.is_some_and(|d| Instant::now() >= d) { Some(Halt::Deadline) }
+    else { None }
+}
+
+/// The third run has one invocation's input disturbed (fault-inject build only): word 12345 * 4.
+fn perturbed(passes: u64) -> u32 {
+    if cfg!(feature = "fault-inject") && passes == 2 {
+        eprintln!("fault-inject: word {}", 12345 * 4);
+        12345
+    } else {
+        NO_PERTURB
+    }
+}
+
+/// Two runs of the same work must agree: the first is then the reference. Words that differ are errors; up
+/// to 3 retries. False when no two runs agreed.
+fn reference(rig: &Rig, n: u32, seed: u32, t0: Instant, st: &mut State) -> Result<bool, vk::Result> {
+    for _ in 0..4 {
+        rig.burn(true, n, seed, NO_PERTURB)?;
+        rig.burn(false, n, seed, NO_PERTURB)?;
+        let (count, first) = rig.compare()?;
+        if count == 0 { return Ok(true); }
+        st.wrong(t0, &mut 0, st.passes + 1, "core", count, &first);
+    }
+    Ok(false)
+}
+
+fn test(rig: &Rig, t0: Instant, seconds: u64, st: &mut State) -> Result<Halt, vk::Result> {
+    // --seconds is the test time after start-up: the first calibration and reference do not count against it.
+    let mut deadline = None;
+    let mut n = 1024;
+    for seed in 1u32.. {
+        if let Some(h) = halt(deadline) { return Ok(h); }
+        n = rig.calibrate(n, seed)?;  // clocks may have settled since the last seed
+        if !reference(rig, n, seed, t0, st)? { return Ok(Halt::Unstable); }
+        let deadline_now = *deadline.get_or_insert_with(|| Instant::now() + Duration::from_secs(seconds));
+        let rotate_at = Instant::now() + ROTATE;
+        while Instant::now() < rotate_at.min(deadline_now) {
+            if let Some(h) = halt(deadline) { return Ok(h); }
+            rig.burn(false, n, seed, perturbed(st.passes))?;
+            let (count, first) = rig.compare()?;
+            st.bytes_checked += BYTES;
+            st.wrong(t0, &mut 0, st.passes + 1, "core", count, &first);
+            st.passes += 1;
+            st.progress(t0);
+        }
+    }
+    unreachable!("the seed loop only ends through a return")
+}
+
+pub fn run(pci: &str, seconds: u64) -> i32 {
+    let (_entry, instance) = device::open().unwrap_or_else(|e| init_failed(&e));
+    let gpus = device::list(&instance).unwrap_or_else(|e| init_failed(&e));
+    let gpu = device::find(&gpus, pci).unwrap_or_else(|e| init_failed(&e));
+    let ctx = Ctx::new(&instance, gpu).unwrap_or_else(|e| init_failed(&format!("could not create the Vulkan device: {e}")));
+    let (heap, _) = ctx.heap_budget();
+    let alloc = || ctx.buffer(BYTES, vk::BufferUsageFlags::STORAGE_BUFFER, Mem::Device(heap));
+    let (cur, reference) = (alloc(), alloc());
+    let (Ok(cur), Ok(reference)) = (cur, reference) else { init_failed("could not allocate the output buffers") };
+    let rig = Rig::new(ctx, &cur, &reference).unwrap_or_else(|e| init_failed(&format!("could not set up the compute pipeline: {e}")));
+    // bytes: what one run compares; there is no chunking in this mode.
+    emit(&json!({"ev": "start", "mode": "core", "pci": gpu.pci, "name": gpu.name, "driver": gpu.driver, "bytes": BYTES, "chunks": 1}));
+
+    let t0 = Instant::now();
+    let mut st = State::default();
+    let outcome = test(&rig, t0, seconds, &mut st);
+    let t = t0.elapsed().as_secs_f64();
+    match outcome {
+        Ok(Halt::Stopped) => end("stopped", t, st.passes, st.errors, "stopped"),
+        Ok(Halt::Unstable) => end("fail", t, st.passes, st.errors, "no two runs of the same work agreed"),
+        Ok(Halt::Deadline) if st.errors > 0 => end("fail", t, st.passes, st.errors, &format!("{} wrong word(s)", st.errors)),
+        Ok(Halt::Deadline) => end("pass", t, st.passes, st.errors, "no errors"),
+        Err(e) => vk_end(e, t, st.passes, st.errors),
+    }
+}
diff --git a/crates/centurion-gpustress/src/ctx.rs b/crates/centurion-gpustress/src/ctx.rs
new file mode 100644
index 0000000..806b1a2
--- /dev/null
+++ b/crates/centurion-gpustress/src/ctx.rs
@@ -0,0 +1,195 @@
+//! The logical device and the few Vulkan helpers both test modes use: buffers, compute pipelines,
+//! descriptor sets and one fenced submission at a time. Nothing is destroyed: the process ends right
+//! after a test and the driver frees everything.
+use crate::device::{self, Gpu};
+use ash::{ext, vk, Device, Instance};
+use std::ffi::CStr;
+
+pub struct Ctx {
+    pub instance: Instance,
+    pub phys: vk::PhysicalDevice,
+    pub dev: Device,
+    pub mem: vk::PhysicalDeviceMemoryProperties,
+    pub limits: vk::PhysicalDeviceLimits,
+    pub max_alloc: u64,
+    queue: vk::Queue,
+    cmd: vk::CommandBuffer,
+    fence: vk::Fence,
+}
+
+pub enum Mem {
+    /// Device-local memory of this heap.
+    Device(u32),
+    /// Host-visible, coherent, mapped for good: the small parameter / result buffers.
+    Host,
+}
+
+pub struct Buf {
+    pub buf: vk::Buffer,
+    pub size: u64,
+    ptr: *mut u32,  // null unless Mem::Host
+}
+
+impl Buf {
+    pub fn get(&self, i: usize) -> u32 {
+        assert!(!self.ptr.is_null() && (i as u64) * 4 < self.size);
+        // SAFETY: inside a mapped, coherent allocation; the device is idle (every submit waits).
+        unsafe { self.ptr.add(i).read_volatile() }
+    }
+    pub fn set(&self, i: usize, v: u32) {
+        assert!(!self.ptr.is_null() && (i as u64) * 4 < self.size);
+        // SAFETY: as in `get`.
+        unsafe { self.ptr.add(i).write_volatile(v) }
+    }
+    /// The shaders' result layout: the count of wrong words, then the first 16 as (index, expected, actual).
+    pub fn mismatches(&self) -> (u32, Vec<[u32; 3]>) {
+        let n = self.get(0);
+        (n, (0..n.min(16) as usize).map(|k| [self.get(1 + 3 * k), self.get(2 + 3 * k), self.get(3 + 3 * k)]).collect())
+    }
+}
+
+impl Ctx {
+    pub fn new(instance: &Instance, gpu: &Gpu) -> Result<Ctx, vk::Result> {
+        // SAFETY: every handle below comes from this instance / device and is used on one thread.
+        unsafe {
+            let fams = instance.get_physical_device_queue_family_properties(gpu.phys);
+            let fam = fams.iter().position(|f| f.queue_flags.contains(vk::QueueFlags::COMPUTE))
+                .ok_or(vk::Result::ERROR_FEATURE_NOT_PRESENT)? as u32;
+            let prio = [1.0f32];
+            let q = [vk::DeviceQueueCreateInfo::default().queue_family_index(fam).queue_priorities(&prio)];
+            let dev = instance.create_device(gpu.phys, &vk::DeviceCreateInfo::default().queue_create_infos(&q), None)?;
+            let pool = dev.create_command_pool(&vk::CommandPoolCreateInfo::default()
+                .queue_family_index(fam).flags(vk::CommandPoolCreateFlags::RESET_COMMAND_BUFFER), None)?;
+            let cmd = dev.allocate_command_buffers(&vk::CommandBufferAllocateInfo::default().command_pool(pool).command_buffer_count(1))?[0];
+            let fence = dev.create_fence(&vk::FenceCreateInfo::default(), None)?;
+            let mut m3 = vk::PhysicalDeviceMaintenance3Properties::default();
+            let mut p2 = vk::PhysicalDeviceProperties2::default().push_next(&mut m3);
+            instance.get_physical_device_properties2(gpu.phys, &mut p2);
+            Ok(Ctx {
+                instance: instance.clone(), phys: gpu.phys, queue: dev.get_device_queue(fam, 0), dev, cmd, fence,
+                mem: instance.get_physical_device_memory_properties(gpu.phys),
+                limits: p2.properties.limits, max_alloc: m3.max_memory_allocation_size,
+            })
+        }
+    }
+
+    /// The device-local heap (the biggest, when the driver exposes several) and what this process may use of it.
+    pub fn heap_budget(&self) -> (u32, u64) {
+        let heaps = &self.mem.memory_heaps[..self.mem.memory_heap_count as usize];
+        let (heap, size) = heaps.iter().enumerate().filter(|(_, h)| h.flags.contains(vk::MemoryHeapFlags::DEVICE_LOCAL))
+            .max_by_key(|(_, h)| h.size).map_or((0, heaps[0].size), |(i, h)| (i, h.size));
+        let mut budget = size;
+        if device::has_ext(&self.instance, self.phys, ext::memory_budget::NAME) {
+            let mut b = vk::PhysicalDeviceMemoryBudgetPropertiesEXT::default();
+            {
+                let mut p2 = vk::PhysicalDeviceMemoryProperties2::default().push_next(&mut b);
+                // SAFETY: the extension is supported by this device.
+                unsafe { self.instance.get_physical_device_memory_properties2(self.phys, &mut p2) };
+            }
+            if b.heap_budget[heap] > 0 { budget = b.heap_budget[heap]; }
+        }
+        (heap as u32, budget)
+    }
+
+    pub fn buffer(&self, size: u64, usage: vk::BufferUsageFlags, mem: Mem) -> Result<Buf, vk::Result> {
+        let types = &self.mem.memory_types[..self.mem.memory_type_count as usize];
+        // SAFETY: plain create / allocate / bind / map calls on handles made here.
+        unsafe {
+            let buf = self.dev.create_buffer(&vk::BufferCreateInfo::default().size(size).usage(usage).sharing_mode(vk::SharingMode::EXCLUSIVE), None)?;
+            let bits = self.dev.get_buffer_memory_requirements(buf).memory_type_bits;
+            let ok = |f: vk::MemoryPropertyFlags, i: usize| (bits >> i) & 1 == 1 && match mem {
+                Mem::Device(heap) => f.contains(vk::MemoryPropertyFlags::DEVICE_LOCAL) && types[i].heap_index == heap,
+                Mem::Host => f.contains(vk::MemoryPropertyFlags::HOST_VISIBLE | vk::MemoryPropertyFlags::HOST_COHERENT),
+            };
+            // Device: a type that is not also host-visible, so a resizable-BAR window is not what gets filled.
+            // Host: plain system memory rather than the BAR, which is slow to read from the host.
+            let avoid = match mem { Mem::Device(_) => vk::MemoryPropertyFlags::HOST_VISIBLE, Mem::Host => vk::MemoryPropertyFlags::DEVICE_LOCAL };
+            let Some(ty) = (0..types.len()).filter(|&i| ok(types[i].property_flags, i)).min_by_key(|&i| types[i].property_flags.contains(avoid)) else {
+                self.dev.destroy_buffer(buf, None);
+                return Err(match mem { Mem::Device(_) => vk::Result::ERROR_OUT_OF_DEVICE_MEMORY, Mem::Host => vk::Result::ERROR_OUT_OF_HOST_MEMORY });
+            };
+            let req = self.dev.get_buffer_memory_requirements(buf);
+            let memory = match self.dev.allocate_memory(&vk::MemoryAllocateInfo::default().allocation_size(req.size).memory_type_index(ty as u32), None) {
+                Ok(m) => m,
+                Err(e) => { self.dev.destroy_buffer(buf, None); return Err(e); }
+            };
+            self.dev.bind_buffer_memory(buf, memory, 0)?;
+            let ptr = match mem {
+                Mem::Device(_) => std::ptr::null_mut(),
+                Mem::Host => self.dev.map_memory(memory, 0, vk::WHOLE_SIZE, vk::MemoryMapFlags::empty())? as *mut u32,
+            };
+            Ok(Buf { buf, size, ptr })
+        }
+    }
+
+    /// Descriptor set layout + pipeline layout for one binding per entry of `kinds`.
+    pub fn layout(&self, kinds: &[vk::DescriptorType]) -> Result<(vk::DescriptorSetLayout, vk::PipelineLayout), vk::Result> {
+        let binds: Vec<_> = kinds.iter().enumerate().map(|(i, &k)| vk::DescriptorSetLayoutBinding::default()
+            .binding(i as u32).descriptor_type(k).descriptor_count(1).stage_flags(vk::ShaderStageFlags::COMPUTE)).collect();
+        // SAFETY: see `new`.
+        unsafe {
+            let dsl = self.dev.create_descriptor_set_layout(&vk::DescriptorSetLayoutCreateInfo::default().bindings(&binds), None)?;
+            let layouts = [dsl];
+            Ok((dsl, self.dev.create_pipeline_layout(&vk::PipelineLayoutCreateInfo::default().set_layouts(&layouts), None)?))
+        }
+    }
+
+    /// `count` descriptor sets of `layout`; `kinds` is the layout's binding list.
+    pub fn sets(&self, layout: vk::DescriptorSetLayout, kinds: &[vk::DescriptorType], count: u32) -> Result<Vec<vk::DescriptorSet>, vk::Result> {
+        let sizes: Vec<_> = kinds.iter().map(|&k| vk::DescriptorPoolSize::default().ty(k).descriptor_count(count)).collect();
+        let layouts = vec![layout; count as usize];
+        // SAFETY: see `new`.
+        unsafe {
+            let pool = self.dev.create_descriptor_pool(&vk::DescriptorPoolCreateInfo::default().max_sets(count).pool_sizes(&sizes), None)?;
+            self.dev.allocate_descriptor_sets(&vk::DescriptorSetAllocateInfo::default().descriptor_pool(pool).set_layouts(&layouts))
+        }
+    }
+
+    /// Points binding i of `set` at `bufs[i]`.
+    pub fn bind(&self, set: vk::DescriptorSet, bufs: &[(vk::DescriptorType, &Buf)]) {
+        for (i, (kind, b)) in bufs.iter().enumerate() {
+            let info = [vk::DescriptorBufferInfo::default().buffer(b.buf).range(vk::WHOLE_SIZE)];
+            let w = [vk::WriteDescriptorSet::default().dst_set(set).dst_binding(i as u32).descriptor_type(*kind).buffer_info(&info)];
+            // SAFETY: the set is not in use (every submit waits for its fence).
+            unsafe { self.dev.update_descriptor_sets(&w, &[]) };
+        }
+    }
+
+    pub fn module(&self, spv: &[u8]) -> Result<vk::ShaderModule, vk::Result> {
+        let words: Vec<u32> = spv.chunks_exact(4).map(|c| u32::from_le_bytes([c[0], c[1], c[2], c[3]])).collect();
+        // SAFETY: see `new`; the SPIR-V comes from build.rs.
+        unsafe { self.dev.create_shader_module(&vk::ShaderModuleCreateInfo::default().code(&words), None) }
+    }
+
+    pub fn pipeline(&self, layout: vk::PipelineLayout, module: vk::ShaderModule, entry: &CStr) -> Result<vk::Pipeline, vk::Result> {
+        let stage = vk::PipelineShaderStageCreateInfo::default().stage(vk::ShaderStageFlags::COMPUTE).module(module).name(entry);
+        let info = [vk::ComputePipelineCreateInfo::default().stage(stage).layout(layout)];
+        // SAFETY: see `new`.
+        unsafe { self.dev.create_compute_pipelines(vk::PipelineCache::null(), &info, None) }.map(|p| p[0]).map_err(|(_, e)| e)
+    }
+
+    /// Records with `record`, submits and waits for the fence: one submission at a time, so none comes
+    /// near a driver watchdog and the host may touch the small buffers between submissions.
+    pub fn submit(&self, record: impl FnOnce(&Device, vk::CommandBuffer)) -> Result<(), vk::Result> {
+        let d = &self.dev;
+        let rw = vk::AccessFlags::SHADER_READ | vk::AccessFlags::SHADER_WRITE;
+        // SAFETY: see `new`; the command buffer is idle because the previous submit waited.
+        unsafe {
+            d.begin_command_buffer(self.cmd, &vk::CommandBufferBeginInfo::default().flags(vk::CommandBufferUsageFlags::ONE_TIME_SUBMIT))?;
+            // The fence only orders a submission for the host: what an earlier one wrote must also be
+            // made visible to this one on the device.
+            let before = [vk::MemoryBarrier::default().src_access_mask(rw).dst_access_mask(rw)];
+            d.cmd_pipeline_barrier(self.cmd, vk::PipelineStageFlags::COMPUTE_SHADER, vk::PipelineStageFlags::COMPUTE_SHADER,
+                vk::DependencyFlags::empty(), &before, &[], &[]);
+            record(d, self.cmd);
+            let after = [vk::MemoryBarrier::default().src_access_mask(vk::AccessFlags::SHADER_WRITE).dst_access_mask(vk::AccessFlags::HOST_READ)];
+            d.cmd_pipeline_barrier(self.cmd, vk::PipelineStageFlags::COMPUTE_SHADER, vk::PipelineStageFlags::HOST,
+                vk::DependencyFlags::empty(), &after, &[], &[]);
+            d.end_command_buffer(self.cmd)?;
+            d.reset_fences(&[self.fence])?;
+            let cmds = [self.cmd];
+            d.queue_submit(self.queue, &[vk::SubmitInfo::default().command_buffers(&cmds)], self.fence)?;
+            d.wait_for_fences(&[self.fence], true, u64::MAX)
+        }
+    }
+}
diff --git a/crates/centurion-gpustress/src/device.rs b/crates/centurion-gpustress/src/device.rs
new file mode 100644
index 0000000..794ed21
--- /dev/null
+++ b/crates/centurion-gpustress/src/device.rs
@@ -0,0 +1,104 @@
+//! Vulkan instance and device discovery. Devices are told apart by PCI address, never "the first one":
+//! a laptop has an iGPU and a dGPU.
+use ash::{vk, Entry, Instance};
+use std::ffi::CStr;
+use std::fs;
+
+pub struct Gpu {
+    pub phys: vk::PhysicalDevice,
+    /// PCI address as in sysfs; "vk:<n>" (n = Vulkan enumeration index) when it cannot be determined,
+    /// which is the normal case for CPU implementations such as lavapipe.
+    pub pci: String,
+    pub name: String,
+    /// "discrete", "integrated", "cpu" or "other".
+    pub kind: &'static str,
+    pub vendor_id: u32,
+    pub device_id: u32,
+    pub vram_mib: u64,
+    pub driver: String,
+}
+
+pub fn open() -> Result<(Entry, Instance), String> {
+    // SAFETY: loads libvulkan.so.1 at run time; a missing library is an ordinary error.
+    let entry = unsafe { Entry::load() }.map_err(|e| format!("Vulkan loader not found: {e}"))?;
+    let app = vk::ApplicationInfo::default().api_version(vk::API_VERSION_1_1);
+    let info = vk::InstanceCreateInfo::default().application_info(&app);
+    // SAFETY: valid create info, no extensions or layers.
+    let instance = unsafe { entry.create_instance(&info, None) }.map_err(|e| format!("could not create a Vulkan instance: {e}"))?;
+    Ok((entry, instance))
+}
+
+pub fn has_ext(instance: &Instance, phys: vk::PhysicalDevice, name: &CStr) -> bool {
+    // SAFETY: phys comes from this instance.
+    unsafe { instance.enumerate_device_extension_properties(phys) }
+        .map(|v| v.iter().any(|e| e.extension_name_as_c_str().is_ok_and(|n| n == name)))
+        .unwrap_or(false)
+}
+
+fn hex_attr(dir: &std::path::Path, name: &str) -> Option<u32> {
+    let s = fs::read_to_string(dir.join(name)).ok()?;
+    u32::from_str_radix(s.trim().trim_start_matches("0x"), 16).ok()
+}
+
+/// Fallback when the driver lacks VK_EXT_pci_bus_info: the sysfs device with these IDs, only if unique.
+fn sysfs_pci(vendor: u32, device: u32) -> Option<String> {
+    let mut found = None;
+    for e in fs::read_dir("/sys/bus/pci/devices").ok()?.flatten() {
+        if hex_attr(&e.path(), "vendor") == Some(vendor) && hex_attr(&e.path(), "device") == Some(device) {
+            if found.is_some() { return None; }  // two cards of one model: cannot tell which is which
+            found = Some(e.file_name().to_string_lossy().into_owned());
+        }
+    }
+    found
+}
+
+pub fn list(instance: &Instance) -> Result<Vec<Gpu>, String> {
+    // SAFETY: valid instance.
+    let physs = unsafe { instance.enumerate_physical_devices() }.map_err(|e| format!("could not enumerate devices: {e}"))?;
+    let mut out = Vec::new();
+    for (i, &phys) in physs.iter().enumerate() {
+        // SAFETY: phys comes from this instance.
+        let props = unsafe { instance.get_physical_device_properties(phys) };
+        if props.api_version < vk::API_VERSION_1_1 { continue; }  // properties2 / memory budget queries below need 1.1
+        let mut pci = None;
+        if has_ext(instance, phys, ash::ext::pci_bus_info::NAME) {
+            let mut b = vk::PhysicalDevicePCIBusInfoPropertiesEXT::default();
+            let mut p2 = vk::PhysicalDeviceProperties2::default().push_next(&mut b);
+            // SAFETY: the extension is supported by this device.
+            unsafe { instance.get_physical_device_properties2(phys, &mut p2) };
+            pci = Some(format!("{:04x}:{:02x}:{:02x}.{:x}", b.pci_domain, b.pci_bus, b.pci_device, b.pci_function));
+        }
+        let pci = pci.or_else(|| sysfs_pci(props.vendor_id, props.device_id)).unwrap_or_else(|| format!("vk:{i}"));
+        let mut driver = String::new();
+        if has_ext(instance, phys, ash::khr::driver_properties::NAME) || props.api_version >= vk::API_VERSION_1_2 {
+            let mut d = vk::PhysicalDeviceDriverProperties::default();
+            let mut p2 = vk::PhysicalDeviceProperties2::default().push_next(&mut d);
+            // SAFETY: driver properties are core in 1.2 or supported through the extension (checked above).
+            unsafe { instance.get_physical_device_properties2(phys, &mut p2) };
+            let n = d.driver_name_as_c_str().map(|s| s.to_string_lossy().into_owned()).unwrap_or_default();
+            let info = d.driver_info_as_c_str().map(|s| s.to_string_lossy().into_owned()).unwrap_or_default();
+            driver = if info.is_empty() { n } else { format!("{n} {info}") };
+        }
+        // SAFETY: phys comes from this instance.
+        let mem = unsafe { instance.get_physical_device_memory_properties(phys) };
+        let vram = mem.memory_heaps[..mem.memory_heap_count as usize].iter()
+            .filter(|h| h.flags.contains(vk::MemoryHeapFlags::DEVICE_LOCAL)).map(|h| h.size).max().unwrap_or(0);
+        out.push(Gpu {
+            phys, pci,
+            name: props.device_name_as_c_str().map(|s| s.to_string_lossy().into_owned()).unwrap_or_default(),
+            kind: match props.device_type {
+                vk::PhysicalDeviceType::DISCRETE_GPU => "discrete",
+                vk::PhysicalDeviceType::INTEGRATED_GPU => "integrated",
+                vk::PhysicalDeviceType::CPU => "cpu",
+                _ => "other",
+            },
+            vendor_id: props.vendor_id, device_id: props.device_id, vram_mib: vram >> 20, driver,
+        });
+    }
+    Ok(out)
+}
+
+/// The device the user named. Never "the first one": a laptop has an iGPU and a dGPU.
+pub fn find<'a>(gpus: &'a [Gpu], pci: &str) -> Result<&'a Gpu, String> {
+    gpus.iter().find(|g| g.pci.eq_ignore_ascii_case(pci)).ok_or_else(|| format!("no Vulkan device {pci} (see `centurion-gpustress list`)"))
+}
diff --git a/crates/centurion-gpustress/src/main.rs b/crates/centurion-gpustress/src/main.rs
new file mode 100644
index 0000000..b2177d3
--- /dev/null
+++ b/crates/centurion-gpustress/src/main.rs
@@ -0,0 +1,147 @@
+//! centurion-gpustress - GPU stability test over Vulkan compute. Runs as the user (never through pkexec),
+//! touches no clocks or curves: it only loads the GPU while the user's curve is in effect.
+//!
+//!   centurion-gpustress list                                           JSON array of the Vulkan devices
+//!   centurion-gpustress vram --device <pci> --percent <10..95> --seconds <s>
+//!   centurion-gpustress core --device <pci> --seconds <s>
+//!
+//! `vram` / `core` print one JSON object per line on stdout (`start`, `progress`, `error`, `end`);
+//! diagnostics go to stderr. Exit code: 0 pass, 1 errors found, 2 device lost, 3 init failure or bad
+//! arguments, 4 stopped. The full specification is docs/GPUSTRESS.md.
+
+mod cores;
+mod ctx;
+mod device;
+mod vram;
+
+use ash::vk;
+use serde_json::{json, Value};
+use std::io::Write;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::Instant;
+
+/// Set by SIGTERM / SIGINT; the tests look at it between submissions.
+static STOP: AtomicBool = AtomicBool::new(false);
+
+extern "C" fn on_stop(_: libc::c_int) { STOP.store(true, Ordering::SeqCst); }
+
+fn emit(v: &Value) {
+    let mut out = std::io::stdout().lock();
+    let _ = writeln!(out, "{v}");
+    let _ = out.flush();
+}
+
+const LINES_PER_PASS: u32 = 16;
+const LINES_PER_RUN: u32 = 200;
+
+/// What `progress` and `end` report, and the caps on `error` lines.
+#[derive(Default)]
+struct State { passes: u64, errors: u64, bytes_checked: u64, lines: u32, last_progress: f64 }
+
+impl State {
+    /// At most one `progress` line per second.
+    fn progress(&mut self, t0: Instant) {
+        let t = t0.elapsed().as_secs_f64();
+        if t - self.last_progress >= 1.0 {
+            self.last_progress = t;
+            emit(&json!({"ev": "progress", "t": secs(t), "passes": self.passes, "bytes_checked": self.bytes_checked, "errors": self.errors}));
+        }
+    }
+
+    /// Counts `count` wrong words; prints the first few as `error` lines within the caps (16 per pass, 200 per
+    /// run). `in_pass` is how many lines this pass has printed.
+    fn wrong(&mut self, t0: Instant, in_pass: &mut u32, pass: u64, pattern: &str, count: u32, first: &[[u32; 3]]) {
+        self.errors += count as u64;
+        for &[word, expected, actual] in first {
+            if *in_pass < LINES_PER_PASS && self.lines < LINES_PER_RUN {
+                *in_pass += 1;
+                self.lines += 1;
+                emit(&json!({"ev": "error", "t": secs(t0.elapsed().as_secs_f64()), "pass": pass, "pattern": pattern,
+                    "word": word, "expected": format!("0x{expected:08x}"), "actual": format!("0x{actual:08x}")}));
+            }
+        }
+    }
+}
+
+/// Seconds to milliseconds precision, for the JSON lines.
+fn secs(t: f64) -> f64 { (t * 1000.0).round() / 1000.0 }
+
+/// Prints the `end` line and returns the exit code that goes with `status`, so the two always agree.
+fn end(status: &str, t: f64, passes: u64, errors: u64, msg: &str) -> i32 {
+    emit(&json!({"ev": "end", "status": status, "t": secs(t), "passes": passes, "errors": errors, "msg": msg}));
+    match status { "pass" => 0, "fail" => 1, "device_lost" => 2, "init_failed" => 3, _ => 4 }
+}
+
+/// `end` line and exit code 3: nothing was tested.
+fn init_failed(msg: &str) -> ! {
+    std::process::exit(end("init_failed", 0.0, 0, 0, msg))
+}
+
+/// A Vulkan error after the test started. A lost device is itself a failed test and is not recreated;
+/// any other error ends the run as `init_failed` (not a verdict about the GPU).
+fn vk_end(e: vk::Result, t: f64, passes: u64, errors: u64) -> i32 {
+    if e == vk::Result::ERROR_DEVICE_LOST { end("device_lost", t, passes, errors, "the device was lost") }
+    else { end("init_failed", t, passes, errors, &format!("Vulkan error: {e}")) }
+}
+
+struct Args { vram: bool, device: String, percent: u32, seconds: u64 }
+
+fn parse(argv: &[String]) -> Result<Args, String> {
+    let vram = match argv.first().map(String::as_str) {
+        Some("vram") => true,
+        Some("core") => false,
+        _ => return Err("usage: centurion-gpustress list | vram --device <pci> --percent <10..95> --seconds <s> | core --device <pci> --seconds <s>".into()),
+    };
+    let (mut device, mut percent, mut seconds) = (None, None, None);
+    let mut it = argv[1..].iter();
+    while let Some(flag) = it.next() {
+        let val = it.next().ok_or(format!("{flag} needs a value"))?;
+        match flag.as_str() {
+            "--device" => device = Some(val.clone()),
+            "--percent" if vram => percent = Some(val.parse::<u32>().map_err(|_| "--percent is not a number")?),
+            "--seconds" => seconds = Some(val.parse::<u64>().map_err(|_| "--seconds is not a number")?),
+            _ => return Err(format!("unknown argument {flag}")),
+        }
+    }
+    let percent = if vram { percent.ok_or("--percent is required")? } else { 0 };
+    if vram && !(10..=95).contains(&percent) { return Err("--percent must be 10..95".into()); }
+    let seconds = seconds.ok_or("--seconds is required")?;
+    if seconds == 0 { return Err("--seconds must be at least 1".into()); }
+    Ok(Args { vram, device: device.ok_or("--device is required")?, percent, seconds })
+}
+
+fn list() -> i32 {
+    let gpus = device::open().and_then(|(_entry, instance)| device::list(&instance));
+    match gpus {
+        Ok(g) => {
+            let arr: Vec<Value> = g.iter().map(|g| json!({
+                "pci": g.pci, "name": g.name, "vendor_id": g.vendor_id, "device_id": g.device_id,
+                "type": g.kind, "vram_mib": g.vram_mib, "driver": g.driver})).collect();
+            println!("{}", Value::Array(arr));
+            0
+        }
+        Err(e) => {
+            eprintln!("centurion-gpustress: {e}");
+            println!("[]");  // still valid JSON for the GUI; the exit code says it failed
+            3
+        }
+    }
+}
+
+fn main() {
+    let argv: Vec<String> = std::env::args().skip(1).collect();
+    if argv.first().map(String::as_str) == Some("list") {
+        std::process::exit(list());
+    }
+    match parse(&argv) {
+        Ok(a) => {
+            // SAFETY: the handler only stores to an atomic.
+            unsafe {
+                libc::signal(libc::SIGTERM, on_stop as *const () as libc::sighandler_t);
+                libc::signal(libc::SIGINT, on_stop as *const () as libc::sighandler_t);
+            }
+            std::process::exit(if a.vram { vram::run(&a.device, a.percent, a.seconds) } else { cores::run(&a.device, a.seconds) })
+        }
+        Err(e) => init_failed(&e),
+    }
+}
diff --git a/crates/centurion-gpustress/src/vram.rs b/crates/centurion-gpustress/src/vram.rs
new file mode 100644
index 0000000..9533398
--- /dev/null
+++ b/crates/centurion-gpustress/src/vram.rs
@@ -0,0 +1,231 @@
+//! VRAM mode (docs/GPUSTRESS.md §4): fills the device-local memory with patterns whose value depends only
+//! on (pattern, global word index, pass seed) and reads them back, counting every wrong word.
+use crate::ctx::{Buf, Ctx, Mem};
+use crate::device;
+use crate::{emit, end, init_failed, vk_end, State, STOP};
+use ash::vk;
+use serde_json::json;
+use std::sync::atomic::Ordering;
+use std::time::{Duration, Instant};
+
+const MIB: u64 = 1 << 20;
+const MIN_BYTES: u64 = 64 * MIB;   // less than this tests too little to mean anything
+const KEEP_FREE: u64 = 256 * MIB;  // the desktop is using this GPU too
+const CHUNK_BYTES: u64 = 256 * MIB;
+const GROUP_WORDS: u64 = 256 * 4;  // one workgroup of vram.wgsl: 256 invocations x 4 words
+const PATTERNS: [&str; 5] = ["addr", "walk1", "walk0", "solid", "random"];
+const SPV: &[u8] = include_bytes!(concat!(env!("OUT_DIR"), "/vram.spv"));
+
+// The patterns in Rust: the fault injection and the unit test need the expected value on the host, and
+// the test runs vram.wgsl to prove both copies agree. Indices are u32 and wrap: above 16 GiB tested, two
+// words exactly 2^32 apart share an `addr` value (a limit of keeping the shader to 32-bit integers).
+#[cfg(any(test, feature = "fault-inject"))]
+fn hash(x: u32) -> u32 {
+    let mut h = x;
+    h ^= h >> 16;
+    h = h.wrapping_mul(0x85eb_ca6b);
+    h ^= h >> 13;
+    h = h.wrapping_mul(0xc2b2_ae35);
+    h ^ (h >> 16)
+}
+
+#[cfg(any(test, feature = "fault-inject"))]
+fn value(pattern: u32, index: u32, seed: u32, phase: u32) -> u32 {
+    match pattern {
+        0 => index ^ hash(seed),
+        1 => 1u32 << (index.wrapping_add(seed) % 32),
+        2 => !(1u32 << (index.wrapping_add(seed) % 32)),
+        3 => if seed.wrapping_add(phase) & 1 == 1 { u32::MAX } else { 0 },
+        _ => hash(index ^ hash(seed.wrapping_add(0x9e37_79b9))),
+    }
+}
+
+/// 2D dispatch size for `words` words, None when the device cannot run 256-wide groups or that many.
+fn dims(l: &vk::PhysicalDeviceLimits, words: u64) -> Option<(u32, u32)> {
+    let groups = words.div_ceil(GROUP_WORDS).max(1);
+    let x = groups.min(l.max_compute_work_group_count[0] as u64);
+    let y = groups.div_ceil(x);
+    (y <= l.max_compute_work_group_count[1] as u64 && l.max_compute_work_group_size[0] >= 256 && l.max_compute_work_group_invocations >= 256)
+        .then_some((x as u32, y as u32))
+}
+
+struct Rig {
+    ctx: Ctx,
+    chunks: Vec<Buf>,
+    sets: Vec<vk::DescriptorSet>,
+    stride: u32,  // words per chunk in the global word index (every chunk but the last is this big)
+    layout: vk::PipelineLayout,
+    fill: vk::Pipeline,
+    verify: vk::Pipeline,
+    params: Buf,
+    found: Buf,  // mismatch count, then the first 16 as (index, expected, actual)
+}
+
+impl Rig {
+    fn new(ctx: Ctx, chunks: Vec<Buf>, stride: u32) -> Result<Rig, vk::Result> {
+        let biggest = chunks.iter().map(|c| c.size / 4).max().unwrap_or(0);
+        dims(&ctx.limits, biggest).ok_or(vk::Result::ERROR_FEATURE_NOT_PRESENT)?;
+        let kinds = [vk::DescriptorType::STORAGE_BUFFER, vk::DescriptorType::UNIFORM_BUFFER, vk::DescriptorType::STORAGE_BUFFER];
+        let (dsl, layout) = ctx.layout(&kinds)?;
+        let params = ctx.buffer(32, vk::BufferUsageFlags::UNIFORM_BUFFER, Mem::Host)?;
+        let found = ctx.buffer(4 * 49, vk::BufferUsageFlags::STORAGE_BUFFER, Mem::Host)?;
+        let sets = ctx.sets(dsl, &kinds, chunks.len() as u32)?;
+        for (s, c) in sets.iter().zip(&chunks) {
+            ctx.bind(*s, &[(kinds[0], c), (kinds[1], &params), (kinds[2], &found)]);
+        }
+        let module = ctx.module(SPV)?;
+        let fill = ctx.pipeline(layout, module, c"fill")?;
+        let verify = ctx.pipeline(layout, module, c"verify")?;
+        Ok(Rig { ctx, chunks, sets, stride, layout, fill, verify, params, found })
+    }
+
+    /// One submission: `fill` or `verify` over chunk `i`. Returns how many words were wrong and the first few.
+    fn run(&self, i: usize, verify: bool, pattern: u32, seed: u32, phase: u32) -> Result<(u32, Vec<[u32; 3]>), vk::Result> {
+        let words = (self.chunks[i].size / 4) as u32;
+        let (x, y) = dims(&self.ctx.limits, words as u64).ok_or(vk::Result::ERROR_FEATURE_NOT_PRESENT)?;
+        for (k, v) in [pattern, seed, (i as u32).wrapping_mul(self.stride), words, phase].iter().enumerate() { self.params.set(k, *v); }
+        self.found.set(0, 0);
+        // SAFETY: recording into the command buffer `submit` has begun, with handles made by `new`.
+        self.ctx.submit(|d, cmd| unsafe {
+            d.cmd_bind_pipeline(cmd, vk::PipelineBindPoint::COMPUTE, if verify { self.verify } else { self.fill });
+            d.cmd_bind_descriptor_sets(cmd, vk::PipelineBindPoint::COMPUTE, self.layout, 0, &[self.sets[i]], &[]);
+            d.cmd_dispatch(cmd, x, y, 1);
+        })?;
+        Ok(self.found.mismatches())
+    }
+}
+
+enum Halt { Deadline, Stopped }
+
+fn halt(t0: Instant, seconds: u64) -> Option<Halt> {
+    if STOP.load(Ordering::SeqCst) { Some(Halt::Stopped) }
+    else if t0.elapsed() >= Duration::from_secs(seconds) { Some(Halt::Deadline) }
+    else { None }
+}
+
+/// Pass 3 only: after its write dispatch a fill flips one bit of one word (the last chunk, so the global
+/// index is beyond the first chunk's range whenever there is more than one). The word and the value it
+/// should hold go to stderr for the integration test to compare with the `error` line.
+#[cfg(feature = "fault-inject")]
+fn inject(rig: &Rig, pattern: u32, seed: u32, phase: u32) -> Result<(), vk::Result> {
+    let last = rig.chunks.len() - 1;
+    let off = 12345.min(rig.chunks[last].size / 4 - 1) as u32;
+    let index = (last as u32).wrapping_mul(rig.stride).wrapping_add(off);
+    let want = value(pattern, index, seed, phase);
+    eprintln!("fault-inject: word {index} expected 0x{want:08x}");
+    let to_fill = vk::MemoryBarrier::default().src_access_mask(vk::AccessFlags::SHADER_WRITE).dst_access_mask(vk::AccessFlags::TRANSFER_WRITE);
+    let from_fill = vk::MemoryBarrier::default().src_access_mask(vk::AccessFlags::TRANSFER_WRITE).dst_access_mask(vk::AccessFlags::SHADER_READ);
+    // SAFETY: recording into the command buffer `submit` has begun.
+    rig.ctx.submit(|d, cmd| unsafe {
+        d.cmd_pipeline_barrier(cmd, vk::PipelineStageFlags::COMPUTE_SHADER, vk::PipelineStageFlags::TRANSFER,
+            vk::DependencyFlags::empty(), &[to_fill], &[], &[]);
+        d.cmd_fill_buffer(cmd, rig.chunks[last].buf, off as u64 * 4, 4, want ^ 1);
+        d.cmd_pipeline_barrier(cmd, vk::PipelineStageFlags::TRANSFER, vk::PipelineStageFlags::COMPUTE_SHADER,
+            vk::DependencyFlags::empty(), &[from_fill], &[], &[]);
+    })
+}
+
+/// One pass: its pattern over every chunk (the solid pattern twice, with the inverse the second time).
+fn pass(rig: &Rig, n: u64, t0: Instant, seconds: u64, st: &mut State) -> Result<Option<Halt>, vk::Result> {
+    let pattern = ((n - 1) % PATTERNS.len() as u64) as u32;
+    let seed = n as u32;
+    let mut lines = 0;
+    for phase in 0..if pattern == 3 { 2 } else { 1 } {
+        for i in 0..rig.chunks.len() {
+            if let Some(h) = halt(t0, seconds) { return Ok(Some(h)); }
+            rig.run(i, false, pattern, seed, phase)?;
+            st.progress(t0);
+        }
+        #[cfg(feature = "fault-inject")]
+        if n == 3 && phase == 0 { inject(rig, pattern, seed, phase)?; }
+        for i in 0..rig.chunks.len() {
+            if let Some(h) = halt(t0, seconds) { return Ok(Some(h)); }
+            let (count, first) = rig.run(i, true, pattern, seed, phase)?;
+            st.bytes_checked += rig.chunks[i].size;
+            st.wrong(t0, &mut lines, n, PATTERNS[pattern as usize], count, &first);
+            st.progress(t0);
+        }
+    }
+    st.passes += 1;
+    Ok(None)
+}
+
+pub fn run(pci: &str, percent: u32, seconds: u64) -> i32 {
+    let (_entry, instance) = device::open().unwrap_or_else(|e| init_failed(&e));
+    let gpus = device::list(&instance).unwrap_or_else(|e| init_failed(&e));
+    let gpu = device::find(&gpus, pci).unwrap_or_else(|e| init_failed(&e));
+    let ctx = Ctx::new(&instance, gpu).unwrap_or_else(|e| init_failed(&format!("could not create the Vulkan device: {e}")));
+
+    let (heap, budget) = ctx.heap_budget();
+    let target = (budget * percent as u64 / 100).min(budget.saturating_sub(KEEP_FREE)) & !(MIB - 1);
+    let chunk = CHUNK_BYTES.min(ctx.limits.max_storage_buffer_range as u64).min(ctx.max_alloc) & !4095;
+    if chunk == 0 { init_failed("the device reports no usable buffer size"); }
+    // TRANSFER_DST only for the fault injection's fill.
+    let usage = vk::BufferUsageFlags::STORAGE_BUFFER | if cfg!(feature = "fault-inject") { vk::BufferUsageFlags::TRANSFER_DST } else { vk::BufferUsageFlags::empty() };
+    let mut chunks = Vec::new();
+    let mut got = 0;
+    while got < target {
+        let size = chunk.min(target - got);
+        match ctx.buffer(size, usage, Mem::Device(heap)) {
+            Ok(b) => { got += size; chunks.push(b); }
+            Err(vk::Result::ERROR_OUT_OF_DEVICE_MEMORY) => break,  // test what was obtained
+            Err(e) => init_failed(&format!("could not allocate VRAM: {e}")),
+        }
+    }
+    if got < MIN_BYTES { init_failed("could not allocate enough VRAM"); }
+
+    let rig = Rig::new(ctx, chunks, (chunk / 4) as u32).unwrap_or_else(|e| init_failed(&format!("could not set up the compute pipeline: {e}")));
+    emit(&json!({"ev": "start", "mode": "vram", "pci": gpu.pci, "name": gpu.name, "driver": gpu.driver, "bytes": got, "chunks": rig.chunks.len()}));
+
+    let t0 = Instant::now();  // --seconds counts from here, after the start-up
+    let mut st = State::default();
+    let outcome = (|| loop {
+        if let Some(h) = pass(&rig, st.passes + 1, t0, seconds, &mut st)? { return Ok::<Halt, vk::Result>(h); }
+    })();
+    let t = t0.elapsed().as_secs_f64();
+    match outcome {
+        Ok(Halt::Stopped) => end("stopped", t, st.passes, st.errors, "stopped"),
+        Ok(Halt::Deadline) if st.errors > 0 => end("fail", t, st.passes, st.errors, &format!("{} wrong word(s)", st.errors)),
+        Ok(Halt::Deadline) => end("pass", t, st.passes, st.errors, "no errors"),
+        Err(e) => vk_end(e, t, st.passes, st.errors),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The Rust patterns must equal vram.wgsl: run the shader on a CPU device (lavapipe) and compare every word,
+    /// then check that `verify` accepts the data and reports one corrupted word exactly.
+    #[test]
+    fn shader_matches_rust() {
+        let Ok((_entry, instance)) = device::open() else { eprintln!("skipped: no Vulkan"); return; };
+        let gpus = device::list(&instance).unwrap();
+        let Some(gpu) = gpus.iter().find(|g| g.kind == "cpu") else { eprintln!("skipped: no CPU Vulkan device"); return; };
+        let ctx = Ctx::new(&instance, gpu).unwrap();
+        const WORDS: u32 = 1 << 16;
+        const STRIDE: u32 = 1_000_003;  // not a power of two: a wrong base shows
+        let chunks: Vec<Buf> = (0..2).map(|_| ctx.buffer(WORDS as u64 * 4, vk::BufferUsageFlags::STORAGE_BUFFER, Mem::Host).unwrap()).collect();
+        let rig = Rig::new(ctx, chunks, STRIDE).unwrap();
+        for pattern in 0..5 {
+            for seed in [1, 4, 5, 70_001] {
+                for phase in 0..2 {
+                    for i in 0..2usize {
+                        let base = (i as u32).wrapping_mul(STRIDE);
+                        rig.run(i, false, pattern, seed, phase).unwrap();
+                        for w in 0..WORDS {
+                            assert_eq!(rig.chunks[i].get(w as usize), value(pattern, base.wrapping_add(w), seed, phase),
+                                "pattern {pattern} seed {seed} phase {phase} chunk {i} word {w}");
+                        }
+                        assert_eq!(rig.run(i, true, pattern, seed, phase).unwrap().0, 0);
+                        let w = 4321 + i as u32;
+                        let want = value(pattern, base + w, seed, phase);
+                        rig.chunks[i].set(w as usize, want ^ 0x10);
+                        let (n, first) = rig.run(i, true, pattern, seed, phase).unwrap();
+                        assert_eq!((n, first), (1, vec![[base + w, want, want ^ 0x10]]));
+                    }
+                }
+            }
+        }
+    }
+}
