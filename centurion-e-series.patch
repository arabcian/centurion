+/// Requests PROBE_SLICE_US for the calling probe thread; the job threads it spawns inherit it.
+fn probe_slice() {
+    let us = PROBE_SLICE_US.load(Ordering::SeqCst);
+    if us > 0 { let _ = crate::tune::set_thread_slice_us(us); }
