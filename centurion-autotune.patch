+    pub fn predcheck_summary(&self, last: usize) -> Option<(usize, f64, [usize; 5])> {
+        let zs: Vec<f64> = self.predcheck.iter().rev().take(last).filter_map(|c| {
+            let (mu, sd, obs) = (c["mu"].as_f64()?, c["sd"].as_f64()?, c["obs"].as_f64()?);
