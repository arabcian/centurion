+    pub fn note_predcheck(&mut self, src: &str, phase: &str, goal: &str, mu: f64, sd: f64, obs: f64) {
+        if !(mu.is_finite() && sd.is_finite() && sd > 0.0 && obs.is_finite()) { return; }
